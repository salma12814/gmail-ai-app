# ===== DATABASE =====
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/gmail_ai_app
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ===== REDIS =====
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379

# ===== ENCRYPTION =====
ENCRYPTION_KEY=your-encryption-key-here          ← PLACEHOLDER

# ===== GOOGLE OAUTH =====
GOOGLE_CLIENT_ID=your-google-client-id-here      ← PLACEHOLDER
GOOGLE_CLIENT_SECRET=your-google-secret-here     ← PLACEHOLDER
GOOGLE_REDIRECT_URI=http://localhost:8081/api/auth/google/callback

# ===== GEMINI API =====
GEMINI_API_KEY=your-gemini-api-key-here          ← PLACEHOLDER

# ===== FRONTEND =====
VITE_API_URL=http://localhost:8081

# ===== LOGGING =====
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_GMAIL_AI=DEBUG